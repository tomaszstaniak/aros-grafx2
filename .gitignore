# Generated dependencies and build outputs. Adapt to the selected stack.
/build/
/dist/
/target/
/node_modules/
/deps/

# Local copies in the optional upstream-patches workflow.
/upstream/
/work/

# Mutable local state; ignored does not mean disposable.
/var/
/local.json
/local.env
/.env
/.env.local

# Local compile-probe logs and the complete pic-samples tarball from
# 2026-09-11. Selected evidence is in docs/attachments/2026-09-11-compile-probe/.
/aros-assessment/

# Raw study material is local by default; keep the source index versioned.
/references/*
!/references/README.md

# Host metadata.
.DS_Store
Thumbs.db
__pycache__/

# Assets, content, source datasets, fixtures and packaging sources are NOT
# blanket-ignored. Record any collection-specific policy in the directory map.
