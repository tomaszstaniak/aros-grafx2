# Copy to local.env (ignored). Environment variables already set win.
# Relative paths resolve from this file's directory.
# Leave a key unset or empty here to keep scripts/env.sh portable defaults.

# AROS_TARGET=one
# AROS_GCC_ROOT=
# AROS_SDK=
# AROS_SHARED=
# AROS_BUILD_VOLUME=
#
# Classic LHa that can create archives. Homebrew /opt/homebrew/bin/lha is
# Lhasa and is read-only. scripts/package.sh requires this.
# LHA_WRITER=
