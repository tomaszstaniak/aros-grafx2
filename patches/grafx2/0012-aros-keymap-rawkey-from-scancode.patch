+// The AROS SDL2 backend turns a raw key into an SDL scancode with this
+// table, indexed by raw key (scancodes_amigaos.h; the same values are in
+// the SDK's libSDL2.a, SDL 2.32.10 for AROS, SDL_arosevents.o). The scancode
+// is positional and can be inverted. The keycode cannot: the backend fills
+// it from the active keymap, so turning it back into a raw key applied the
+// keymap twice (y and z swapped on QWERTZ), and every keymap character
+// above 0x7F arrives as a negative keycode.
+#define S(x) SDL_SCANCODE_##x
+static const SDL_Scancode AROS_rawkey_scancode[] = {
+  S(GRAVE), S(1), S(2), S(3),                                  // 0x00
+  S(4), S(5), S(6), S(7),                                      // 0x04
+  S(8), S(9), S(0), S(MINUS),                                  // 0x08
+  S(EQUALS), S(BACKSLASH), S(INTERNATIONAL3), S(KP_0),         // 0x0C
+  S(Q), S(W), S(E), S(R),                                      // 0x10
+  S(T), S(Y), S(U), S(I),                                      // 0x14
+  S(O), S(P), S(LEFTBRACKET), S(RIGHTBRACKET),                 // 0x18
+  S(UNKNOWN), S(KP_1), S(KP_2), S(KP_3),                       // 0x1C
+  S(A), S(S), S(D), S(F),                                      // 0x20
+  S(G), S(H), S(J), S(K),                                      // 0x24
+  S(L), S(SEMICOLON), S(APOSTROPHE), S(INTERNATIONAL1),        // 0x28
+  S(UNKNOWN), S(KP_4), S(KP_5), S(KP_6),                       // 0x2C
+  S(INTERNATIONAL2), S(Z), S(X), S(C),                         // 0x30
+  S(V), S(B), S(N), S(M),                                      // 0x34
+  S(COMMA), S(PERIOD), S(SLASH), S(UNKNOWN),                   // 0x38
+  S(KP_PERIOD), S(KP_7), S(KP_8), S(KP_9),                     // 0x3C
+  S(SPACE), S(BACKSPACE), S(TAB), S(KP_ENTER),                 // 0x40
+  S(RETURN), S(ESCAPE), S(DELETE), S(INSERT),                  // 0x44
+  S(PAGEUP), S(PAGEDOWN), S(KP_MINUS), S(F11),                 // 0x48
+  S(UP), S(DOWN), S(RIGHT), S(LEFT),                           // 0x4C
+  S(F1), S(F2), S(F3), S(F4),                                  // 0x50
+  S(F5), S(F6), S(F7), S(F8),                                  // 0x54
+  S(F9), S(F10), S(KP_LEFTPAREN), S(KP_RIGHTPAREN),            // 0x58
+  S(KP_DIVIDE), S(KP_MULTIPLY), S(KP_PLUS), S(SCROLLLOCK),     // 0x5C
+  S(LSHIFT), S(RSHIFT), S(CAPSLOCK), S(LCTRL),                 // 0x60
+  S(LALT), S(RALT), S(LGUI), S(RGUI),                          // 0x64
+  S(UNKNOWN), S(UNKNOWN), S(UNKNOWN), S(MENU),                 // 0x68
+  S(KP_PERIOD), S(PRINTSCREEN), S(PAUSE), S(F12),              // 0x6C
+  S(HOME), S(END)                                              // 0x70
+};
+#undef S
 
-  if (sym >= SDLK_a && sym <= SDLK_z)
-    return letter_codes[sym - SDLK_a];
-  if (sym >= SDLK_1 && sym <= SDLK_9)
-    return RAWKEY_1 + sym - SDLK_1;
+static int AROS_Rawkey_code(SDL_Scancode scancode)
+{
+  int rawkey;
 
-  switch (sym)
-  {
-    case SDLK_0:            return RAWKEY_0;
-    case SDLK_SPACE:        return RAWKEY_SPACE;
-    case SDLK_MINUS:        return RAWKEY_MINUS;
-    case SDLK_EQUALS:       return RAWKEY_EQUAL;
-    case SDLK_LEFTBRACKET:  return RAWKEY_LBRACKET;
-    case SDLK_RIGHTBRACKET: return RAWKEY_RBRACKET;
-    case SDLK_BACKSLASH:    return RAWKEY_BACKSLASH;
-    case SDLK_SEMICOLON:    return RAWKEY_SEMICOLON;
-    case SDLK_QUOTE:        return RAWKEY_QUOTE;
-    case SDLK_BACKQUOTE:    return RAWKEY_TILDE;
-    case SDLK_COMMA:        return RAWKEY_COMMA;
-    case SDLK_PERIOD:       return RAWKEY_PERIOD;
-    case SDLK_SLASH:        return RAWKEY_SLASH;
-    case SDLK_KP_0:         return RAWKEY_KP_0;
-    case SDLK_KP_1:         return RAWKEY_KP_1;
-    case SDLK_KP_2:         return RAWKEY_KP_2;
-    case SDLK_KP_3:         return RAWKEY_KP_3;
-    case SDLK_KP_4:         return RAWKEY_KP_4;
-    case SDLK_KP_5:         return RAWKEY_KP_5;
-    case SDLK_KP_6:         return RAWKEY_KP_6;
-    case SDLK_KP_7:         return RAWKEY_KP_7;
-    case SDLK_KP_8:         return RAWKEY_KP_8;
-    case SDLK_KP_9:         return RAWKEY_KP_9;
-    case SDLK_KP_PERIOD:    return RAWKEY_KP_DECIMAL;
-    case SDLK_KP_DIVIDE:    return RAWKEY_KP_DIVIDE;
-    case SDLK_KP_MULTIPLY:  return RAWKEY_KP_MULTIPLY;
-    case SDLK_KP_MINUS:     return RAWKEY_KP_MINUS;
-    case SDLK_KP_PLUS:      return RAWKEY_KP_PLUS;
-    case SDLK_KP_ENTER:     return RAWKEY_KP_ENTER;
-    default:                return -1;
-  }
+  if (scancode == SDL_SCANCODE_UNKNOWN)
+    return -1;
+  // First match: KP_PERIOD appears twice and 0x3C is the keypad key.
+  for (rawkey = 0; rawkey < (int)(sizeof(AROS_rawkey_scancode)/sizeof(AROS_rawkey_scancode[0])); rawkey++)
+    if (AROS_rawkey_scancode[rawkey] == scancode)
+      return rawkey;
+  return -1;
 }
 
 static UWORD AROS_Qualifier(SDL_Keymod mod)
@@ -919,15 +924,16 @@ static UWORD AROS_Qualifier(SDL_Keymod mod)
   if (mod & KMOD_RALT)   qualifier |= IEQUALIFIER_RALT;
   if (mod & KMOD_LGUI)   qualifier |= IEQUALIFIER_LCOMMAND;
   if (mod & KMOD_RGUI)   qualifier |= IEQUALIFIER_RCOMMAND;
-  if (mod & KMOD_NUM)    qualifier |= IEQUALIFIER_NUMERICPAD;
   return qualifier;
