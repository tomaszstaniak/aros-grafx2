+/// Returns 1 when the keymap decided the character (possibly none, as for
+/// a dead key or a lone modifier), 0 to let the generic SDL2 code decide.
 static int AROS_Keysym_to_ANSI(SDL_Keysym keysym, word *ansi)
 {
   struct InputEvent event = { 0 };
   UBYTE text[8];
-  int rawkey = AROS_Rawkey_code(keysym.sym);
+  int rawkey = AROS_Rawkey_code(keysym.scancode);
   WORD length;
 
   if (rawkey < 0)
@@ -936,7 +942,20 @@ static int AROS_Keysym_to_ANSI(SDL_Keysym keysym, word *ansi)
   event.ie_Code = rawkey;
   event.ie_Qualifier = AROS_Qualifier(keysym.mod);
   length = MapRawKey(&event, (STRPTR)text, sizeof(text), NULL);
-  *ansi = length > 0 ? text[0] : 0;
+  // A control character produced by Ctrl (Ctrl+A is 0x01) is a command,
+  // not text; the generic code would turn it back into the plain letter.
+  if (length == 0 || (text[0] < 0x20 && (event.ie_Qualifier & IEQUALIFIER_CONTROL)))
+  {
+    *ansi = 0;
+    return 1;
+  }
+  // Control characters (Return, Esc, Tab, Ctrl+letter) and CSI sequences
+  // (cursor and function keys) keep their generic handling, which the
+  // shortcut and editing code expects. A key mapped to a string of more
+  // than one character is not representable in Key_ANSI.
+  if (length != 1 || text[0] < 0x20 || (text[0] >= 0x7F && text[0] < 0xA0))
+    return 0;
+  *ansi = text[0];
   return 1;
 }
