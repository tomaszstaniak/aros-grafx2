diff --git a/src/io.c b/src/io.c
index e4f1be8e..feecdcf8 100644
--- a/src/io.c
+++ b/src/io.c
@@ -1147,9 +1147,17 @@ char * Get_current_directory(char * buf, word * * unicode, size_t size)
 
 int Change_directory(const char * path)
 {
+  if (path == NULL)
+    return -1;
   GFX2_Log(GFX2_DEBUG, "Change_directory(\"%s\")\n", path);
 #if defined(__WIN32__) || defined(WIN32)
   return (SetCurrentDirectoryA(path) ? 0 : -1);
+#elif defined(__AROS__) || defined(__MORPHOS__) || defined(__amigaos4__) || defined(__amigaos__)
+  /* PARENT_DIR is "/" on these systems (Amiga "cd /"). POSIX chdir("/") is
+   * the unix root and fails; map the parent entry to "..". */
+  if (path[0] == '/' && path[1] == '\0')
+    return chdir("..");
+  return chdir(path);
 #else
   return chdir(path);
 #endif
