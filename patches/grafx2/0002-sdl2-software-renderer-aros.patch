   source_rect.x = x;
   source_rect.y = y;
   if (width == 0 && height == 0) {
@@ -229,11 +275,20 @@ static void GFX2_UpdateRect(int x, int y, int width, int height)
     RGBcopy = SDL_CreateRGBSurface(0,
     Screen_SDL->w, Screen_SDL->h,
     32, 0, 0, 0, 0);
